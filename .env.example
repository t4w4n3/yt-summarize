# Runtime settings. Never put API keys here.
PORT=8080
DATA_DIR=/data
ARTIFACTS_DIR=/artifacts
STT_MODEL=microsoft/mai-transcribe-2
# Retry borné sur les erreurs transitoires du provider STT (429 / 5xx) :
# 3 tentatives, backoff exponentiel plafonné (1s puis 2s max 8s, avec jitter).
STT_RETRY_MAX_ATTEMPTS=3
STT_RETRY_BASE_DELAY_MS=1000
STT_RETRY_MAX_DELAY_MS=8000
# Plafond de l'attente demandée par le provider (Retry-After), en ms. Couvre le
# 402 « in_flight_budget_exhausted » d'OpenRouter, qui demande ~120 s.
STT_RETRY_AFTER_MAX_MS=120000
LLM_PROVIDER=openrouter
LLM_MODEL=meta/muse-ember
# Épingle le résumé sur un seul endpoint OpenRouter (slug du provider) + une
# quantification, avec fallbacks désactivés. Vide = routage OpenRouter par défaut.
LLM_PROVIDER_PIN=google-vertex/global
# Vide = aucune contrainte de quantification (l'endpoint épinglé ne sert pas
# forcément du fp8 ; un filtre qui ne correspond à aucun endpoint fait échouer
# la requête en « no allowed providers »).
LLM_QUANTIZATION=
LLM_THINKING=high
WORKER_POLL_MS=2000
JOB_TIMEOUT_MS=1800000
STALE_AFTER_MS=600000
# Plafond par vidéo de la taille de l'audio téléchargé par yt-dlp (octets).
# 500 MiB par défaut : une vidéo plus longue est rejetée, l'espace
# artifacts du volume ne peut pas être rempli par un seul download.
MAX_DOWNLOAD_BYTES=524288000
# Plafond du WAV converti (octets). 512 MiB par défaut (~4 h à 16 kHz mono) :
# au-delà, le job est rejeté avant toute lecture entière en RAM (F-1).
MAX_WAV_BYTES=536870912
# Plafond du transcript lu par le résumeur (octets). 1 MiB par défaut (F-1 bis).
MAX_TRANSCRIPT_BYTES=1048576
# Mullvad VPN: yt-dlp passe par le tunnel du sidecar `vpn`.
# Désactive (false) pour revenir au download direct depuis l'IP du datacenter.
MULLVAD_ENABLED=true
# Proxy SOCKS5 du sidecar, par nom de service sur le réseau bridge (aardvark-dns).
# Worker lancé sur l'hôte (mise run worker, hors conteneur) : mets
# socks5h://127.0.0.1:1080 (le sidecar publie le SOCKS sur le loopback hôte).
MULLVAD_PROXY=socks5h://vpn:1080
# Rate limiting (todo.md P3) on POST /api/summarize + POST /api/jobs/:id/retry,
# per client IP, fixed window: 10 requêtes/min par défaut. Plafonne le rythme
# de dépense OpenRouter si l'app est exposée (GET illimités, l'UI poll).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
