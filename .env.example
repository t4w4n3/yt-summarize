# Runtime settings. Never put API keys here.
PORT=8080
DATA_DIR=/data
ARTIFACTS_DIR=/artifacts
STT_MODEL=microsoft/mai-transcribe-2
# Retry borné sur les erreurs transitoires du provider STT (429 / 5xx) :
# 3 tentatives, backoff exponentiel plafonné (1s puis 2s max 8s, avec jitter).
STT_RETRY_MAX_ATTEMPTS=3
STT_RETRY_BASE_DELAY_MS=1000
STT_RETRY_MAX_DELAY_MS=8000
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# Épingle le résumé sur un seul endpoint OpenRouter (slug du provider) + une
# quantification, avec fallbacks désactivés. Vide = routage OpenRouter par défaut.
LLM_PROVIDER_PIN=deepinfra
LLM_QUANTIZATION=fp8
LLM_THINKING=high
WORKER_POLL_MS=2000
JOB_TIMEOUT_MS=1800000
STALE_AFTER_MS=600000
# Mullvad VPN: yt-dlp tourne dans un container jetable qui passe par le tunnel.
# Désactive (false) pour revenir au download direct depuis l'IP du datacenter.
MULLVAD_ENABLED=true
