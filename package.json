{
  "name": "summarize-yt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "description": "Self-hosted YouTube learning-summary workstation",
  "type": "module",
  "main": "src/infrastructure/inbound/http.ts",
  "scripts": {
    "start": "node src/infrastructure/inbound/http.ts",
    "start:worker": "node src/infrastructure/inbound/worker.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts e2e/ui.spec.ts",
    "test:e2e:stack": "playwright test --config e2e/playwright.config.ts e2e/stack.spec.ts",
    "test:e2e:containers": "playwright test --config e2e/playwright.containers.config.ts",
    "test:unit": "node --test 'tests/unit/**/*.test.ts'",
    "test:integration": "node --test 'tests/integration/**/*.test.ts'",
    "test:arch": "node --test 'tests/arch/**/*.test.ts'",
    "test:live": "RUN_LIVE_TESTS=1 node --test 'tests/live/**/*.live.test.ts'",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run test:arch && pnpm run test:integration && pnpm run test:e2e",
    "coverage": "node scripts/coverage.ts",
    "cov:gate": "node scripts/coverage.ts --min-lines 80",
    "mutation": "stryker run",
    "mutation:domain": "stryker run",
    "mutation:all": "stryker run --mutate 'src/**/*.ts'",
    "mutation:dry": "stryker run --dryRunOnly"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "archunit": "^2.5.5",
    "markdownlint-cli": "^0.50.1",
    "typescript": "^6.0.3"
  }
}
